{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "workforce": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7001",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Provider__InstanceId": "workforce",
        "Provider__DisplayName": "CookieLearning Workforce Provider",
        "Provider__Issuer": "https://localhost:7001/",
        "Provider__CookieName": "__Host-CookieLearning.Workforce",
        "ConnectionStrings__DefaultConnection": "Data Source=workforce.db;Cache=Shared",
        "Seed__UserEmail": "alice@workforce.example.test"
      }
    },
    "external": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7002",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Provider__InstanceId": "external",
        "Provider__DisplayName": "CookieLearning External Provider",
        "Provider__Issuer": "https://localhost:7002/",
        "Provider__CookieName": "__Host-CookieLearning.External",
        "ConnectionStrings__DefaultConnection": "Data Source=external.db;Cache=Shared",
        "Seed__UserEmail": "alice@external.example.test"
      }
    }
  }
}
